{
  "name": "contra.io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "typecheck": "astro check && tsc --noEmit && tsc -p api && tsc -p scripts",
    "check": "biome ci . && bun run typecheck && bun run api:test && bun scripts/no-js.ts",
    "api:dev": "wrangler dev --config api/wrangler.jsonc --local --port 8787",
    "api:migrate:local": "wrangler d1 migrations apply contra-leaderboard --config api/wrangler.jsonc --local",
    "api:test": "bun test api"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "astro": "^7.4.5",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "5.20261103.1",
    "@types/bun": "^1.3.14",
    "@types/three": "^0.187.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^6.0.3",
    "wrangler": "4.156.2"
  },
  "packageManager": "bun@1.3.14"
}
