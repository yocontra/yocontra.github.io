    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "astro": "^7.4.5",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.3.14",
    "@types/three": "^0.187.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14"
