{
  "name": "contra.io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "typecheck": "bun --bun astro check && tsc --noEmit && tsc -p api && tsc -p scripts && tsc -p tests && tsc -p tools",
    "check": "bun scripts/check.ts",
    "debt": "bun scripts/lint-debt.ts && bun scripts/debt-audit.ts",
    "api:dev": "wrangler dev --config api/wrangler.jsonc --local --port 8787 --infer-origin-from-routes=false",
    "api:migrate:local": "wrangler d1 migrations apply contra-leaderboard --config api/wrangler.jsonc --local",
    "test": "bun test --parallel=4 --timings=tests/timings.json api tests",
    "api:test": "bun test api",
    "audit:buildings": "bun tools/building-audit.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/realtimekit": "2.0.4",
    "@colyseus/core": "0.18.27",
    "@colyseus/schema": "5.0.45",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/shared-types": "0.18.3",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "astro": "^7.4.7",
    "meshoptimizer": "^1.3.0",
    "playcanvas": "2.23.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.6",
    "@cloudflare/workers-types": "5.20261106.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/bun": "^1.3.14",
    "@webgpu/types": "^0.1.74",
    "miniflare": "5.20261104.0-beta",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "4.158.0"
  },
  "packageManager": "bun@1.3.14"
}
