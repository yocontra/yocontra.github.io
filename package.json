{
  "name": "contra.io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "build:worker": "bun scripts/build-worker.ts",
    "preview": "bun --bun astro preview",
    "lint": "oxlint --deny-warnings && biome lint .",
    "format": "biome format --write . && bun run format:ts",
    "fix": "oxlint --fix && biome check --write . && bun run format:ts",
    "typecheck": "bun --bun astro check && tsrs --noEmit && tsrs -p api && tsrs -p scripts && tsrs -p tests && tsrs -p tools",
    "check": "bun scripts/check.ts",
    "debt": "bun scripts/lint-debt.ts && bun scripts/debt-audit.ts",
    "api:dev": "wrangler dev --config api/wrangler.jsonc --local --port 8787 --infer-origin-from-routes=false",
    "api:migrate:local": "wrangler d1 migrations apply contra-leaderboard --config api/wrangler.jsonc --local",
    "test": "bun test --parallel=4 --timings=tests/timings.json api tests",
    "api:test": "bun test api",
    "audit:buildings": "bun tools/building-audit.ts",
    "format:ts": "oxfmt --write '**/*.ts'",
    "format:check": "oxfmt --check '**/*.ts'"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/realtimekit": "2.0.4",
    "@colyseus/core": "0.18.27",
    "@colyseus/schema": "5.0.45",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/shared-types": "0.18.3",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "astro": "^7.4.7",
    "colyseus-cloudflare": "0.1.0",
    "meshoptimizer": "^1.3.0",
    "playcanvas": "2.23.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.6",
    "@cloudflare/workers-types": "5.20261106.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/bun": "^1.3.14",
    "@webgpu/types": "^0.1.74",
    "fontkitten": "1.0.3",
    "miniflare": "5.20261104.0-beta",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "^1.65.0",
    "rolldown": "1.2.16",
    "sharp": "^0.35.5",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "wrangler": "4.158.0"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "playcanvas@2.23.3": "patches/playcanvas@2.23.3.patch",
    "astro@7.4.7": "patches/astro@7.4.7.patch"
  }
}
