{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "contra-leaderboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "contra-leaderboard",
      // Placeholder for local dev. Replaced with the real id from `wrangler d1 create` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "DUELS", "class_name": "DuelSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DuelSession"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://contra.io,http://localhost:4321"
  }
}
