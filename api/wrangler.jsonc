{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "contra-leaderboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The API is served on its own subdomain (same site as contra.io, so refresh cookies stay first-party).
  // Requires the contra.io zone on Cloudflare (the DNS move at release; see RELEASE.md).
  "routes": [{ "pattern": "api.contra.io", "custom_domain": true }],
  // Only the custom domain: no *.workers.dev URL or preview URLs that would bypass the origin checks.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["17 4 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "contra-leaderboard",
      // Local dev ignores this id. `bun scripts/release.ts` creates the production database and writes its id here.
      "database_id": "a4c8682b-e5f0-435e-b252-d42195509240",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DUELS", "class_name": "DuelSession" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "DUEL_ROOMS", "class_name": "DuelRoom" },
      { "name": "LOBBY_DIR", "class_name": "LobbyDirectory" },
      { "name": "LOBBIES", "class_name": "Lobby" },
      { "name": "DAILY_SESSIONS", "class_name": "DailySession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DuelSession"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker", "DuelRoom", "LobbyDirectory", "Lobby"] },
    { "tag": "v3", "new_sqlite_classes": ["DailySession"] }
  ],
  // Cloudflare's rate-limiting binding (no charge on any Workers plan, counted in memory per
  // location, no D1 or Durable Object work): guest Daily tries, before they reach D1.
  "ratelimits": [
    { "name": "DAILY_GUEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 4, "period": 60 } }
  ],
  "vars": {
    "DISABLE_VOICE": "true",
    "ALLOWED_ORIGINS": "https://contra.io",
    "RP_ID": "contra.io",
    "RP_ORIGINS": "https://contra.io",
    "CLOUDFLARE_ACCOUNT_ID": "5947ed3a469d16386b7f9f74a6bed807",
    "REALTIMEKIT_APP_ID": "bd20498e-64a8-4f8a-849e-fa4caca3ec7d",
    "REALTIMEKIT_PRESET": "out-west-voice"
  }
}
