---
const lead =
  'I like building things end to end: backends, frontends, and the infrastructure in between.'
const words = lead.split(' ')
const step = 60 / words.length
---

<section id="about" class="about wrap" aria-labelledby="about-title">
  <p class="eyebrow" id="about-title">About</p>
  <p class="statement">
    {words.map((word, i) => (
      <span
        style={`animation-range: cover ${(12 + i * step).toFixed(2)}% cover ${(20 + i * step).toFixed(2)}%`}
      >
        {word}{' '}
      </span>
    ))}
  </p>

  <div class="detail">
    <p class="reveal">
      Most of my career has been at small companies, a few of which I helped start, plus a couple of
      years at Apple.
    </p>
    <p class="reveal">
      These days I’m co-founding Plaza and Veil Labs, consulting with Trigram, and doing open
      source.
    </p>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(6rem, 18vh, 12rem) clamp(4rem, 10vh, 8rem);
  }

  .statement {
    margin-top: 1.5rem;
    max-width: 22ch;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4.6vw, 4.4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    view-timeline-name: --statement;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .statement span {
        color: var(--fg-faint);
        animation: lit linear both;
        animation-timeline: --statement;
      }
    }
  }

  @keyframes lit {
    to {
      color: var(--fg);
    }
  }

  .detail {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    margin-left: auto;
    max-width: 44rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem 2.5rem;
  }

  .detail p {
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.5;
    color: var(--fg-muted);
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
</style>
