---
const statement =
  'I like building things end to end: backends, frontends, and the infrastructure in between. Most of my career has been at small companies, a few of which I helped start, plus a couple of years at Apple. These days I’m co-founding Veil Labs and Plaza, consulting with Trigram, and doing open source on the side.'
const words = statement.split(' ')
const step = 70 / words.length
---

<section id="about" class="about wrap" aria-labelledby="about-title">
  <p class="eyebrow" id="about-title">About</p>
  <p class="statement">
    {words.map((word, i) => (
      <span
        style={`animation-range: cover ${(10 + i * step).toFixed(2)}% cover ${(16 + i * step).toFixed(2)}%`}
      >
        {word}{' '}
      </span>
    ))}
  </p>
</section>

<style>
  .about {
    padding-block: clamp(6rem, 18vh, 12rem) clamp(4rem, 10vh, 8rem);
  }

  .statement {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.6rem, 3.6vw, 3.4rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    view-timeline-name: --statement;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .statement span {
        color: var(--fg-faint);
        animation: lit linear both;
        animation-timeline: --statement;
      }
    }
  }

  @keyframes lit {
    to {
      color: var(--fg);
    }
  }
</style>
