---
import { moreProjectsHref, projects } from '~/data/projects'
import { formatCompact, getStars, getWeeklyDownloads } from '~/lib/github'

const items = await Promise.all(
  projects.map(async (project) => {
    const live = project.source ? await getStars(project.source) : null
    const stars = live ?? project.stars
    const weekly = project.npm ? await getWeeklyDownloads(project.npm) : null
    return { ...project, stars, weekly }
  }),
)
---

<section id="oss" class="oss wrap" aria-labelledby="oss-title">
  <header class="head">
    <p class="eyebrow">Open source</p>
    <h2 id="oss-title">Some things I’ve made</h2>
  </header>

  <ul class="bento">
    {items.map((p) => (
      <li class:list={['card', 'spot', 'reveal', { featured: p.featured, wide: p.wide }]}>
        <a href={p.href}>
          <div class="top">
            <h3>{p.name}</h3>
            {p.tag && <span class="tag">{p.tag}</span>}
          </div>
          <p>{p.blurb}</p>
          <div class="meta">
            {p.stars !== undefined && p.stars > 0 && (
              <span>
                <span aria-hidden="true">★</span> {formatCompact(p.stars)}
                <span class="visually-hidden"> GitHub stars</span>
              </span>
            )}
            {p.weekly != null && <span>↓ {formatCompact(p.weekly)}/wk on npm</span>}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </div>
        </a>
      </li>
    ))}
    <li class="card spot reveal more wide">
      <a href={moreProjectsHref}>
        <h3>200 more…</h3>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  </ul>
</section>

<style>
  .oss {
    padding-block: clamp(4rem, 10vh, 8rem);
  }

  .head h2 {
    margin-top: 1rem;
    font-size: clamp(2.4rem, 6vw, 5rem);
  }

  .bento {
    list-style: none;
    padding: 0;
    margin: clamp(2.5rem, 6vh, 4rem) 0 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    grid-auto-flow: dense;
  }

  .card {
    container-type: inline-size;
    position: relative;
    border-radius: var(--radius);
    background:
      radial-gradient(
        28rem circle at var(--mx, 50%) var(--my, -20%),
        oklch(0.86 0.2 var(--accent-h) / 0.14),
        transparent 45%
      ),
      var(--bg-raised);
    border: 1px solid var(--line);
    transition:
      border-color 0.3s,
      translate 0.5s var(--ease-out);
  }

  .card:hover {
    border-color: oklch(0.86 0.2 var(--accent-h) / 0.45);
    translate: 0 -3px;
  }

  .card a {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    min-height: 15rem;
    padding: 1.6rem;
    text-decoration: none;
    color: inherit;
  }

  .featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  .wide {
    grid-column: span 2;
  }

  @media (max-width: 40rem) {
    .featured,
    .wide {
      grid-column: auto;
      grid-row: auto;
    }
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  h3 {
    font-size: min(1.6rem, 8.5cqi);
    letter-spacing: -0.03em;
  }

  .featured h3 {
    font-size: clamp(2.6rem, 14cqi, 6.5rem);
    letter-spacing: -0.05em;
  }

  .featured p {
    font-size: clamp(1.05rem, 3.4cqi, 1.45rem);
    max-width: 30ch;
  }

  .card p {
    color: var(--fg-muted);
  }

  .meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
    font: 0.85rem / 1 var(--font-mono);
    color: var(--fg-muted);
  }

  .arrow {
    margin-left: auto;
    font-size: 1.2rem;
    transition: translate 0.4s var(--ease-out);
  }

  .card:hover .arrow {
    translate: 3px -3px;
    color: var(--accent);
  }

  .tag {
    font: 600 0.7rem / 1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.45em 0.7em;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .more a {
    justify-content: space-between;
    flex-direction: row;
    align-items: flex-end;
  }

  .more h3 {
    color: var(--fg-muted);
  }
</style>

<script>
  import { spotlight } from '~/lib/spotlight'

  spotlight(document.querySelectorAll<HTMLElement>('.spot'))
</script>
