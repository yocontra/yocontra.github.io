---
import Bare from '~/layouts/Bare.astro'
---

<Bare title="HACKED" noindex>
  <noscript slot="head"
    ><style is:inline>
      body {
        background: url("/experiments/hax/bg.gif");
      }
    </style></noscript
  >
  <canvas id="hax-bg" aria-hidden="true"></canvas>
  <div id="hacked">YOU GOT HACKED</div>
</Bare>

<!--
  Ported verbatim from the 2021 original. Changes: sizes scale down below ~800px wide, and the
  tiled bg.gif is now a WebGL2 shader (src/experiments/hax). The gif remains the no-WebGL/no-JS fallback.
-->
<style is:global>
  body {
    cursor: pointer;
    background: #6b1418;
  }
  #hax-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: -1;
    pointer-events: none;
  }
  #hacked {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    animation: blink 1s steps(1) infinite;
    background: red;
    color: white;
    font-size: min(120px, 15vw);
    padding: min(64px, 8vw);
  }

  @keyframes blink {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
</style>

<script>
  import { mountBackground } from '~/experiments/hax/background.ts'

  const canvas = document.querySelector('#hax-bg')
  if (canvas instanceof HTMLCanvasElement) {
    const dispose = mountBackground(canvas, document.querySelector('#hacked'))
    window.addEventListener('pagehide', (e) => {
      if (!e.persisted) {
        dispose()
      }
    })
  }

  // Both files are mp4s; only their AAC audio tracks are used (as in the original).
  const tracks = ['/experiments/hax/jolly.mp4', '/experiments/hax/boom.mp4'].map((src) => {
    const track = new Audio(src)
    track.loop = true
    return track
  })
  document.addEventListener('click', () => {
    for (const track of tracks) {
      track.play().catch(() => undefined)
    }
  })
</script>
