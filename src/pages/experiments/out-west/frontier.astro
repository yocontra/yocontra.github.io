---
import Bare from '~/layouts/Bare.astro'
---

<Bare
  title="out west: Frontier"
  description="Frontier: a 32-player free-for-all in the western town of Perdition."
  viewport="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover"
  noindex
>
  <Fragment slot="head">
    <meta name="theme-color" content="#2a1d12" />
    <link
      rel="preload"
      href="/experiments/out-west/fonts/ultra.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/experiments/out-west/fonts/oswald-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/experiments/out-west/fonts/eb-garamond.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </Fragment>
  <div id="frontier"></div>
</Bare>

<script>
  /*
   * Dev and direct access. Query params: server=loopback|remote (default loopback here),
   * bots=N, lag=ms, jitter=ms, lobby=id, name=…, token=… (dev), cluster (loopback: the bots crowd
   * around you, for packed-scene perf runs), seed=N and spawn=x,z (dev: a repeatable start for the
   * perf harness). Plus the renderer's #tier= and #perf.
   */
  import { mountFrontier } from '~/experiments/out-west/ffa/client/index.ts'
  import { installViewportVars } from '~/experiments/out-west/platform/viewport.ts'

  const root = document.querySelector<HTMLElement>('#frontier')
  const q = new URLSearchParams(location.search)
  const num = (k: string): number | undefined => {
    const v = Number(q.get(k))
    return q.has(k) && Number.isFinite(v) ? v : undefined
  }
  if (root) {
    installViewportVars()
    for (const t of ['gesturestart', 'dblclick']) {
      document.addEventListener(t, (e) => e.preventDefault(), { passive: false })
    }
    const lag = num('lag')
    const jitter = num('jitter')
    const bots = num('bots')
    const lobby = q.get('lobby')
    const name = q.get('name')
    // Dev only: a pre-minted access token (automated runs without a passkey).
    // Never honoured in production builds: tokens must not travel in URLs.
    const token = import.meta.env.DEV ? q.get('token') : null
    // Dev only (perf harness): a fixed lobby seed and first spawn, `seed=7&spawn=72,66`.
    const seed = import.meta.env.DEV ? num('seed') : undefined
    const [sx, sz] = (import.meta.env.DEV ? (q.get('spawn') ?? '') : '').split(',').map(Number)
    const spawn =
      sx !== undefined && sz !== undefined && Number.isFinite(sx) && Number.isFinite(sz)
        ? { x: sx, z: sz }
        : undefined
    mountFrontier(root, {
      server: q.get('server') === 'remote' ? 'remote' : 'loopback',
      ...(bots === undefined ? {} : { bots }),
      ...(lag === undefined ? {} : { lagMs: lag }),
      ...(jitter === undefined ? {} : { jitterMs: jitter }),
      ...(lobby ? { lobbyId: lobby } : {}),
      ...(name ? { name } : {}),
      ...(q.has('cluster') ? { cluster: true } : {}),
      ...(seed === undefined ? {} : { seed }),
      ...(spawn ? { spawn } : {}),
      ...(token ? { getToken: () => Promise.resolve(token) } : {}),
      onExit: () => {
        location.href = '/experiments/out-west/?saloon'
      },
    })
  }
</script>
