---
import Bare from '~/layouts/Bare.astro'

// Stream H crowd spike (dev/perf only, not listed in experiments.ts).
---

<Bare
  title="out west: crowd spike"
  noindex
  viewport="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover"
>
  <canvas class="ow-canvas crowd-canvas" aria-label="Crowd performance spike"></canvas>
  <div class="crowd-status" aria-live="polite"></div>
</Bare>

<style is:global>
  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #000;
  }
  .crowd-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    display: block;
  }
  .crowd-status {
    position: fixed;
    left: 12px;
    top: 12px;
    color: #fff;
    font:
      14px / 1.4 ui-monospace,
      Menlo,
      monospace;
  }
</style>

<script>
  import { bootCrowd } from '~/experiments/out-west/ffa/scene/crowd/main.ts'

  const canvas = document.querySelector<HTMLCanvasElement>('.crowd-canvas')
  const status = document.querySelector<HTMLElement>('.crowd-status')
  if (canvas && status) {
    bootCrowd(canvas, status).catch((e: unknown) => {
      status.textContent = `crowd spike failed: ${String(e)}`
    })
  }
</script>
