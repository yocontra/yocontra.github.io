---
import Bare from '~/layouts/Bare.astro'
import '~/experiments/out-west/ui/tokens.css'
import '~/experiments/out-west/ui/controls.css'
import '~/experiments/out-west/ui/out-west.css'
import '~/experiments/out-west/ui/out-west-menus.css'
import '~/experiments/out-west/ui/account.css'
import '~/experiments/out-west/ui/hub.css'
import '~/experiments/out-west/ui/sheets.css'
---

<Bare
  title="out west · sign in to the app"
  description="Sign in with your passkey to continue in the out west app."
  viewport="width=device-width, initial-scale=1, viewport-fit=cover"
  noindex
>
  <Fragment slot="head">
    <meta name="theme-color" content="#120c08" />
  </Fragment>
  <main id="ow" class="ow ow-page">
    <p class="ow-page-mark" aria-hidden="true">Out West</p>
    <div class="ow-hub-panel ow-page-panel">
      <h1 class="ow-hub-h">Sign in to the app</h1>
      <p class="ow-hub-note ow-page-status" aria-live="polite">
        Sign in with your passkey, then we’ll send you back to the app.
      </p>
      <div class="ow-page-host"></div>
    </div>
  </main>
</Bare>

<style is:global>
  .ow-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: safe center;
    gap: var(--ow-s4);
    padding: max(var(--ow-s4), var(--ow-sai-t)) var(--ow-s3) max(var(--ow-s4), var(--ow-sai-b));
    background-color: var(--ow-night);
    background-image:
      radial-gradient(80% 60% at 50% 30%, rgb(110 64 30 / 0.35), transparent 70%),
      var(--ow-tex-smoke);
    background-size:
      100% 100%,
      384px 384px;
    overflow-y: auto;
    touch-action: pan-y;
  }
  .ow-page-mark {
    margin: 0;
    font-family: var(--ow-font-ornate);
    font-weight: 400;
    font-size: clamp(2.5rem, 12vw, 4rem);
    line-height: 0.9;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ow-red-hi);
    text-shadow: 0 3px 0 #000;
  }
  .ow-page-panel {
    width: min(30rem, 100%);
    animation: ow-paper-in var(--ow-t-slow) var(--ow-ease-out) both;
  }
  .ow-page-back {
    color: var(--ow-bone);
    font-weight: 600;
    font-variant-caps: all-small-caps;
    letter-spacing: var(--ow-track-label);
    font-size: var(--ow-fs-lead);
    text-underline-offset: 4px;
  }
  .ow-page-back:focus-visible {
    outline: 2px solid var(--ow-brass-hi);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .ow-page-panel {
      animation: none;
    }
  }
</style>

<script>
  import type { AppAuthPurpose } from '~/experiments/out-west/contract/auth.ts'
  import { currentPlayer, handoffToApp, onAuthChange } from '~/experiments/out-west/net/auth.ts'
  import { mountAccount } from '~/experiments/out-west/ui/account.ts'

  const host = document.querySelector<HTMLElement>('.ow-page-host')
  const status = document.querySelector<HTMLElement>('.ow-page-status')
  const q = new URLSearchParams(location.search)
  const challenge = q.get('challenge') ?? ''
  const state = q.get('state') ?? ''
  const redirectUri = q.get('redirect_uri') ?? ''
  const purpose = q.get('purpose')

  const say = (text: string): void => {
    if (status) {
      status.textContent = text
    }
  }

  let handing = false
  const handoff = async (): Promise<void> => {
    if (handing || !currentPlayer()) {
      return
    }
    handing = true
    say('Signed in. Handing you back to the app…')
    const r = await handoffToApp({
      challenge,
      state,
      redirect_uri: redirectUri,
      ...(purpose === 'login' || purpose === 'register' || purpose === 'reauth'
        ? { purpose: purpose as AppAuthPurpose }
        : {}),
    })
    if (r.ok) {
      location.replace(r.value)
      return
    }
    handing = false
    say(r.error)
  }

  if (!(challenge && state && redirectUri)) {
    say('This link is missing its app details. Open sign-in from the out west app again.')
  } else if (host) {
    mountAccount(host)
    onAuthChange(() => {
      handoff().catch(() => undefined)
    })
    handoff().catch(() => undefined)
  }
</script>
