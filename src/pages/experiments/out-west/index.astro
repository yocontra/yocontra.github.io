---
import Bare from '~/layouts/Bare.astro'
import '~/experiments/out-west/ui/out-west.css'
---

<Bare
  title="out west"
  description="A western quick-draw duel in 3D: walk your paces, wait for the bell, and draw first."
  viewport="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover"
>
  <Fragment slot="head">
    <meta name="theme-color" content="#ff0000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&display=swap"
    />
  </Fragment>
  <div id="ow" class="ow">
    <canvas class="ow-canvas" aria-label="Out West, a 3D quick-draw duel"></canvas>
    <div class="ow-title">
      <h1 class="ow-logo">out west</h1>
      <div class="ow-start">
        <span class="desktop-only">click to draw</span><span class="touch-only">tap to draw</span>
      </div>
      <div class="ow-loading" aria-live="polite"></div>
      <div class="ow-howto">
        <span class="desktop-only"
          >Hold W, ↑ or ← (or the mouse) to walk. Wait for the bell. Space or click to draw.</span
        >
        <span class="touch-only">Hold anywhere to walk. Wait for the bell. Tap to draw.</span>
      </div>
      <div class="ow-title-links">
        <a href="/experiments/out-west/classic/">play the 2019 original</a>
        <span aria-hidden="true">·</span>
        <button type="button" class="ow-credits-btn">credits</button>
        <span aria-hidden="true">·</span>
        <button type="button" class="ow-board-btn">leaderboard</button>
      </div>
      <div class="ow-credits" role="dialog" aria-label="Credits">
        <p>
          <b>out west</b>
          by Eric Schoffstall. Music and the original sounds from the 2019 game.
        </p>
        <p>Characters, guns and props: Quaternius (CC0), Kay Lousberg (CC0), via poly.pizza.</p>
        <p>Textures: Poly Haven (CC0). Sound effects: freesound.org contributors (CC0).</p>
        <p>Full list: <a href="/experiments/out-west/3d/CREDITS.md">CREDITS.md</a></p>
      </div>
    </div>
  </div>
</Bare>

<script>
  import { boot } from '~/experiments/out-west/main.ts'

  const root = document.querySelector<HTMLElement>('#ow')
  if (root) {
    boot(root)
  }
</script>
