---
import Bare from '~/layouts/Bare.astro'
import '~/experiments/out-west/ui/tokens.css'
import '~/experiments/out-west/ui/controls.css'
import '~/experiments/out-west/ui/out-west.css'
import '~/experiments/out-west/ui/duel-cards.css'
import '~/experiments/out-west/ui/title.css'
import '~/experiments/out-west/ui/out-west-menus.css'
import '~/experiments/out-west/ui/account.css'
import '~/experiments/out-west/ui/hub.css'
import '~/experiments/out-west/ui/sheets.css'
import '~/experiments/out-west/ui/board.css'
import '~/experiments/out-west/ui/store.css'
import '~/experiments/out-west/ui/pvp.css'
import '~/experiments/out-west/ui/features.css'
import '~/experiments/out-west/ui/meta.css'
import '~/experiments/out-west/ui/gazette.css'
---

<Bare
  title="out west"
  description="A 3D western quick-draw duel. Walk your paces, wait for the bell, then draw."
  viewport="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover"
>
  <Fragment slot="head">
    <meta name="theme-color" content="#120c08" />
    <link
      rel="preload"
      href="/experiments/out-west/fonts/rye.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/experiments/out-west/fonts/ultra.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/experiments/out-west/fonts/eb-garamond.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/experiments/out-west/ui/paper.webp" as="image" />
  </Fragment>
  <div id="ow" class="ow">
    <canvas class="ow-canvas" aria-label="Out West, a 3D quick-draw duel"></canvas>
    <div class="ow-title">
      <div class="ow-title-sheet">
        <span class="ow-title-kicker">A quick-draw western</span>
        <h1 class="ow-logo">Out West</h1>
        <span class="ow-orn-rule" aria-hidden="true"></span>
        <div class="ow-title-art" aria-hidden="true"></div>
        <div class="ow-start">
          <span class="desktop-only">click to start</span><span class="touch-only">tap to start</span>
        </div>
        <div class="ow-loading" aria-live="polite"></div>
        <div class="ow-howto">
          <span class="desktop-only"
            >Hold <kbd>W</kbd>, <kbd>↑</kbd> or the mouse to walk. Wait for the bell.
            <kbd>Space</kbd>
            or click to draw.</span
          >
          <span class="touch-only">Hold anywhere to walk. Wait for the bell. Tap to draw.</span>
        </div>
      </div>
      <div class="ow-title-links">
        <a href="/experiments/out-west/classic/">play the 2019 original</a>
        <span aria-hidden="true">·</span>
        <button type="button" class="ow-credits-btn">credits</button>
        <span aria-hidden="true">·</span>
        <button type="button" class="ow-board-btn">leaderboard</button>
      </div>
      <div class="ow-credits" role="dialog" aria-label="Credits">
        <p>
          <b>out west</b>
          by Eric Schoffstall. Music and the original sounds from the 2019 game.
        </p>
        <p>Characters, guns and props: Quaternius (CC0), Kay Lousberg (CC0), via poly.pizza.</p>
        <p>Textures: Poly Haven (CC0). Sound effects: freesound.org contributors (CC0).</p>
        <p>
          Type: Ultra (Astigmatic, Apache 2.0); Rye (Sorkin Type), EB Garamond (Georg Duffner,
          Octavio Pardo) and Oswald (Vernon Adams), SIL OFL. Paper, woodcut, seal and icon art
          generated with Gemini.
        </p>
        <p>Full list: <a href="/experiments/out-west/3d/CREDITS.md">CREDITS.md</a></p>
      </div>
    </div>
  </div>
</Bare>

<script>
  import { boot } from '~/experiments/out-west/main.ts'

  const root = document.querySelector<HTMLElement>('#ow')
  if (root) {
    boot(root)
  }
</script>
