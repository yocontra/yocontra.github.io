---
import Favicon from '~/components/Favicon.astro'

/**
 * Unstyled document shell for experiments: no global CSS, no fonts, no resets.
 * Experiments must render exactly as their originals did.
 */
interface Props {
  title: string
  description?: string
  noindex?: boolean
  /** Legacy pages that had no viewport meta can opt out to match their original rendering. */
  viewport?: string | false
  /** Benchmarks: skip the spinning favicon so it never shows up in a profile. */
  staticFavicon?: boolean
}

const {
  title,
  description,
  noindex = false,
  viewport = 'width=device-width, initial-scale=1',
  staticFavicon = false,
} = Astro.props
---

<!doctype html>
<html lang="en" data-static-favicon={staticFavicon ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    {viewport && <meta name="viewport" content={viewport} />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <Favicon />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
