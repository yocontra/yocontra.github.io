{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": ["public/**", ".astro/**", "dist/**", ".claude/**", "**/.wrangler/**"]
}
