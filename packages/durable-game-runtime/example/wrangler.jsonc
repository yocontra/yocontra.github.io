{
  "name": "durable-game-runtime-example",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ExampleRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ExampleRoom"] }]
}
